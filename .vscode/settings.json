{
  "workbench.colorCustomizations": {
    "editor.background": "#000",
    "scrollbarSlider.activeBackground": "#fffb00",
    "scrollbarSlider.background": "#fffb00a2",
    "scrollbarSlider.hoverBackground": "#fffb00b5",
    "sideBar.border": "#0080ff",
    "activityBar.background": "#2d1467",
    "titleBar.activeBackground": "#5c43ff",
    "titleBar.activeForeground": "#ffffff",
    "tab.activeBackground": "#3344a8",
    "tab.inactiveBackground": "#3333",
    "tab.border": "#3300ff40",
    "editorIndentGuide.background1": "#a9ffa565",
    "editorIndentGuide.activeBackground1": "#3dff33",
    "sideBar.background": "#000009",
    "terminal.background": "#000003",
    "minimap.findMatchHighlight": "#fff200dd",
    "minimap.selectionOccurrenceHighlight": "#fff200dd",
    "minimap.selectionHighlight": "#fff200dd",
    "editor.selectionBackground": "#00fffb42",
    "editor.wordHighlightBackground": "#00fffb14"
  },
  "terminal.integrated.fastScrollSensitivity": 5,
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.mouseWheelZoom": true,
  "vscode-edge-devtools.webRoot": "${workspaceFolder}/src/",
  "emmet.triggerExpansionOnTab": true,
  "github.copilot.chat.editor.temporalContext.enabled": true,
  "editor.semanticTokenColorCustomizations": {
    "rules": {
      "class": {
        "foreground": "#ffc757"
      }
    }
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "comment",
        "settings": {
          "foreground": "#ffffff5b"
        }
      },
      {
        "scope": "punctuation.definition.string.begin",
        "settings": {
          "foreground": "#ffee00"
        }
      },
      {
        "scope": "punctuation.definition.string.end",
        "settings": {
          "foreground": "#ffee00"
        }
      },
      {
        "scope": "punctuation.separator.continuation",
        "settings": {
          "foreground": "#ff7300"
        }
      },
      {
        "scope": "punctuation.definition.parameters.begin",
        "settings": {
          "foreground": "#ff7300"
        }
      },
      {
        "scope": "punctuation.definition.parameters.end",
        "settings": {
          "foreground": "#ff7300"
        }
      },
      {
        "scope": "punctuation.definition.string.template.begin",
        "settings": {
          "foreground": "#ffee00"
        }
      },
      {
        "scope": "punctuation.definition.string.template.end",
        "settings": {
          "foreground": "#ffee00"
        }
      },
      {
        "scope": "punctuation.definition.template-expression.begin",
        "settings": {
          "foreground": "#ff8800"
        }
      },
      {
        "scope": "punctuation.definition.template-expression.end",
        "settings": {
          "foreground": "#ff8800"
        }
      },
      {
        "scope": "punctuation.definition.tag.begin",
        "settings": {
          "foreground": "#fffb00"
        }
      },
      {
        "scope": "punctuation.definition.tag.end",
        "settings": {
          "foreground": "#fffb00"
        }
      },
      {
        "scope": "keyword.operator.logical",
        "settings": {
          "foreground": "#ff7b00"
        }
      },
      {
        "scope": "keyword.control.at-rule",
        "settings": {
          "foreground": "#fff700"
        }
      },
      {
        "scope": "punctuation.definition.block",
        "settings": {
          "foreground": "#ffee00"
        }
      },
      {
        "scope": "entity.name.tag",
        "settings": {
          "foreground": "#ff961f"
        }
      }
    ]
  }
}